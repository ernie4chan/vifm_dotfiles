" {{{ Editor.

" Pick the first available vi-compatible editor.
if executable('vim')
	set vicmd=vim
elseif executable('nvim')
	set vicmd=nvim
elseif executable('elvis')
	set vicmd=elvis\ -G\ termcap
elseif executable('vile')
	set vicmd=vile
elseif $EDITOR != ''
	echo 'Note: using `'.$EDITOR.'` as an editor'
	let &vicmd = $EDITOR
endif

" }}}

" {{{ Display.

" Colorschme: picks the first one supported by the terminal.
colorscheme gruvbox

" Try to leave some space from cursor to upper/lower border in lists.
set scrolloff=2

" Status line layout.
set statusline="  %t%= %A   | %8u:%-8g | %10E   | %25d   "

" Customize view columns (enable ellipsis for truncated file names).
set viewcolumns=-{name}..,6{size},16{mtime}.

" Time format for the file list.
set timefmt=%d/%m/%y\ %H:%M

" }}}

" {{{ Behavior.

" Perform file operations natively instead of relying on external utilities.
set syscalls

" Trash Directory.
set trash

" Follow symbolic links on 'l' or Enter.
set followlinks

" Natural sort of version numbers within text.
set sortnumbers

" Do not execute files on Enter or 'l'.
set norunexec

" Allow partial command execution when unambiguous (e.g. :!Te → :!Terminal).
set fastrun

" Number of directories to keep in history.
set history=10000

" Maximum number of undoable changes.
set undolevels=100

" Persist session data between vifm restarts.
set vifminfo=dhistory,savedirs,chistory,state,tui,shistory,
    \phistory,fhistory,dirstack,registers,bookmarks,bmarks

" Use Vim-style help with highlighting and hyperlinks.
set vimhelp

" If would rather use a plain text help file set novimhelp.
"set novimhelp

" Skip slow/remote filesystems for metadata requests.
if !has('win')
	set slowfs=curlftpfs
endif

" Suppress "Permission denied" errors with GNU find
if system("find --version | grep -c 'GNU findutils'") != 0
	set findprg='find %s %a -print , -type d \( ! -readable -o ! -executable \) -prune'
endif

" Show list of matches on tab completion in command-line mode.
set wildmenu

" Display completions in a form of popup with descriptions of the matches.
set wildstyle=popup

" Display suggestions in normal, visual and view modes for keys, marks and
"  registers (at most 5 files). In other view, when available.
set suggestoptions=normal,visual,view,otherpane,keys,marks,registers

" }}}

" {{{ Searching.

" Grep program with suppressed permission errors.
set grepprg="grep -n -H -I -r -s %i %a %s"

" Ignore case in search patterns.
set ignorecase

" Override ignorecase when pattern contains uppercase.
set smartcase

" Disable incremental search.
set noincsearch

" Highlight all matches after search is confirmed.
set hlsearch

" }}}

" {{{ Bookmarks.

" :mark mark /full/directory/path [filename]
mark d ~/Descargas
mark D ~/Downloads
mark h ~/

" }}}

" {{{ Commands.

" :com[mand][!] command_name action
" The following macros can be used in a command.
" %a is replaced with the user arguments.
" %c the current file under the cursor.
" %C the current file under the cursor in the other directory.
" %f the current selected file, or files.
" %F the current selected file, or files in the other directory.
" %b same as %f %F.
" %d the current directory name.
" %D the other window directory name.
" %m run the command in a menu window.

command! df df -h %m 2> /dev/null
command! diff vim -d %f %F
command! zip zip -r %c.zip %f
command! run !! ./%f
command! make !!make %a
command! mkcd :mkdir %a | cd %a
command! reload :write | restart full

" Fuzzy file search using fzf.
command! FZFfind : set noquickview
				\| let $FZF_PICK = system('find | fzf 2>/dev/tty')
				\| if $FZF_PICK != ''
				\|     execute 'goto' fnameescape($FZF_PICK)
				\| endif
				\| redraw

" }}}

" {{{ Mappings.

" --- Navigation ---

" Fuzzy search files.
nnoremap <C-T> :FZFfind<CR>

" MC-like: Mirror current directory in the other pane.
nnoremap <A-I> :sync<CR>

" MC-like: Open directory under cursor in the other pane.
nnoremap <A-O> :sync %c<CR>

" --- Workspace ---

" Ranger's miller columns and tree view.
nnoremap \n :tree!<CR>
nnoremap \m :set millerview!<CR>

" Switch panes.
nnoremap \x <C-W>x

" Tab manipulation.
nnoremap \q	:tabclose<CR>
nnoremap \t :tabnew<CR>
nnoremap \; :tabprevious<CR>
nnoremap \' :tabnext<CR>

" Restore vertical/horizontal double panel.
nnoremap \v :vsplit<CR>
nnoremap \s :split<CR>

" Equalize pane sizes.
nnoremap \= <C-W>=

" Toggle zoom on current pane.
nnoremap \- <CR>_

" Decrease/increase pane width.
nnoremap \3 5<C-W><
nnoremap \5 5<C-W>>

" Decrease/increase pane height.
nnoremap \r 5<C-W>-
nnoremap \4 5<C-W>+

" --- File Operations ---

" Example of standard two-panel file managers mappings.
nnoremap <F3> :!less %f<CR>
nnoremap <F4> :edit<CR>
nnoremap <F5> :copy<CR>
nnoremap <F6> :move<CR>
nnoremap <F7> :mkdir<space>
nnoremap <F8> :delete<CR>
nnoremap <F10> :quit<CR>
nnoremap <F12> :touch<space>
" Toggle line wrap.
nnoremap <F9> :set wrap!<CR>:if &wrap | echo 'Wrap on' | else | echo 'Wrap off' | endif<CR>

" --- Editing ---

" Rename without the extension: cursor at end, start, or clear.
nnoremap A	cW
nnoremap I	cW<C-A>
nnoremap R	cW<C-U>

" Rename including the extension: cursor at end, start, or clear.
"nnoremap A	cw
nnoremap cb	cw<C-A>
nnoremap cc	cw<C-U>

" Start shell in current directory.
nnoremap s :shell<CR>

" Display sorting dialog.
nnoremap S :sort<CR>

" Toggle visibility of preview window.
nnoremap w :view<CR>
vnoremap w :view<CR>gv

" Open editor to edit 'vifmrc' and apply settings after returning to Vifm.
nnoremap \ce :write | edit $MYVIFMRC | restart full<CR>

" --- Open With ---

" Open file in the background using its default program
nnoremap gb :file &<CR>l

if executable('code')
	" Open file in VS Code tab.
	nnoremap o :!code %f<CR>
	" Open file in VS Code new window.
	nnoremap O :!code --new-window %f<CR>
endif

" }}}

" {{{ Copy & Paste.

" yd = yank current directory path.
" yf = yank full file path.
" yn = yank filename.
" yr = yank filename without extension.

if executable('clip.exe') && executable('wslpath')
	" WSL2: pipe to clip.exe; no trailing newline (-n).
	nnoremap yd :!echo -n %d | clip.exe %i<CR>
	nnoremap yf :!echo -n %c:p | clip.exe %i<CR>
	nnoremap yn :!echo -n %c | clip.exe %i<CR>
	nnoremap yr :!echo -n %c:r | clip.exe %i<CR>
elseif has('win')
	" Native Windows: convert slashes for compatibility.
	nnoremap yd :!echo %"d:gs!\!/! %i | clip<CR>
	nnoremap yf :!echo %"c:gs!\!/! %i | clip<CR>
	nnoremap yn :!echo %"c:gs!\!/! %i | clip<CR>
	nnoremap yr :!echo %"c:r:gs!\!/! %i | clip<CR>
elseif has('mac')
	nnoremap yd :!printf %d | pbcopy<CR>
	nnoremap yf :!printf %c:p | pbcopy<CR>
	nnoremap yn :!printf %c | pbcopy<CR>
	nnoremap yr :!printf %c:r | pbcopy<CR>
elseif executable('wl-copy')
	nnoremap yd :!echo -n %d | wl-copy %i<CR>
	nnoremap yf :!echo -n %c:p | wl-copy %i<CR>
	nnoremap yn :!echo -n %c | wl-copy %i<CR>
	nnoremap yr :!echo -n %c:r | wl-copy %i<CR>
elseif executable('xclip')
	nnoremap yd :!echo -n %d | xclip %i<CR>
	nnoremap yf :!echo -n %c:p | xclip %i<CR>
	nnoremap yn :!echo -n %c | xclip %i<CR>
	nnoremap yr :!echo -n %c:r | xclip %i<CR>
elseif executable('xsel')
	nnoremap yd :!echo -n %d | xsel --input --primary %i &&
		\ echo -n %d | xsel --clipboard --input %i<CR>
	nnoremap yf :!echo -n %c:p | xsel --input --primary %i &&
		\ echo -n %c:p | xsel --clipboard --input %i<CR>
	nnoremap yn :!echo -n %c | xsel --input --primary %i &&
		\ echo -n %c | xsel --clipboard --input %i<CR>
	nnoremap yr :!echo -n %c:r | xsel --input --primary %i &&
		\ echo -n %c:r | xsel --clipboard --input %i<CR>
endif

" }}}

" {{{ File Types.
" :filetype pattern1,pattern2 defaultprogram,program2
" :fileviewer pattern1,pattern2 consoleviewer

" --- Images ---
filetype	{*.bmp,*.jpg,*.jpeg,*.png,*.gif,*.xpm},
			\<image/*>
			\ {Open in Irfanview}
			\ cmd.exe /c start
			\ "O:\\Scoop\\Local\\apps\\irfanview\\current\\i_view64.exe"
			\ "$(wslpath -w %c)" &
fileviewer	{*.bmp,*.jpg,*.jpeg,*.png,*.gif,*.xpm},
			\<image/*>
			\ cmd.exe /c
			\ "O:\\Scoop\\Local\\apps\\ffmpeg\\current\\bin\\ffprobe.exe"
			\ -hide_banner
			\ "$(wslpath -w %c)" 2>&1

" --- Audio ---
filetype	{*.wav,*.mp3,*.flac,*.m4a,*.wma,*.ape,*.ac3,*.og[agx],*.spx,*.opus,
			\*.aac,*.mpga},
			\<audio/*>
			\ {Play in ffplay}
			\ cmd.exe /c
			\ "O:\\Scoop\\Local\\apps\\ffmpeg\\current\\bin\\ffplay.exe"
			\ -nodisp -hide_banner -autoexit
			\ "$(wslpath -w %c)" &
fileviewer	{*.wav,*.mp3,*.flac,*.m4a,*.wma,*.ape,*.ac3,*.og[agx],*.spx,*.opus,
			\*.aac,*.mpga},
			\<audio/*>
			\ cmd.exe /c
			\ "O:\\Scoop\\Local\\apps\\ffmpeg\\current\\bin\\ffprobe.exe"
			\ -hide_banner -pretty
			\ "$(wslpath -w %c)" 2>&1

" --- Video ---
filetype	{*.avi,*.mp4,*.wmv,*.dat,*.3gp,*.ogv,*.mkv,*.mpg,*.mpeg,*.vob,
			\*.fl[icv],*.m2v,*.mov,*.webm,*.ts,*.mts,*.m4v,*.r[am],*.qt,*.divx,
			\*.as[fx]},
			\<video/*>
			\ {Play in ffplay}
			\ cmd.exe /c
			\ "O:\\Scoop\\Local\\apps\\ffmpeg\\current\\bin\\ffplay.exe"
			\ -hide_banner -autoexit
			\ "$(wslpath -w %c)" &
fileviewer	{*.avi,*.mp4,*.wmv,*.dat,*.3gp,*.ogv,*.mkv,*.mpg,*.mpeg,*.vob,
			\*.fl[icv],*.m2v,*.mov,*.webm,*.ts,*.mts,*.m4v,*.r[am],*.qt,*.divx,
			\*.as[fx]},
			\<video/*>
			\ cmd.exe /c
			\ "O:\\Scoop\\Local\\apps\\ffmpeg\\current\\bin\\ffprobe.exe"
			\ -hide_banner -pretty
			\ "$(wslpath -w %c)" 2>&1

" --- Pdf ---
filetype	{*.pdf},<application/pdf>
			\ {Open in Acrobat}
			\ cmd.exe /c start
			\ "C:\\Program Files\\Adobe\\Acrobat DC\\Acrobat\\Acrobat.exe"
			\ "$(wslpath -w %c)" &
fileviewer	{*.pdf},<application/pdf>
			\ strings %c | head -50

" --- man page ---
filetype	{*.[1-8]},<text/troff> man ./%c
fileviewer	{*.[1-8]},<text/troff> man ./%c | col -b

" --- Web ---
filextype	{*.xhtml,*.html,*.htm},<text/html>
			\ {Open with Brave}
			\ cmd.exe /c start
			\ "C:\\Users\\ernie4chan\\AppData\\Local\\BraveSoftware\\Brave-Browser\\Application\\brave.exe"
			\ "$(wslpath -w %c)" &
filetype	{*.xhtml,*.html,*.htm},<text/html> lynx

" --- MS Office ---
filetype	{*.xlsx,*.xls,*.ods},
			\<application/vnd.openxmlformats-officedocument.spreadsheetml*,
			\application/vnd.ms-excel*,application/msexcel>
			\ {Open in Excel}
			\ cmd.exe /c start
			\ "C:\\Program Files\\Microsoft Office\\root\\Office16\\EXCEL.EXE"
			\ "$(wslpath -w %c)" &
filetype	{*.docx,*.doc,*.odt},
			\<application/vnd.openxmlformats-officedocument.wordprocessingml*,
			\application/vnd.ms-word*,application/msword>
			\ {Open in Word}
			\ cmd.exe /c start
			\ "C:\\Program Files\\Microsoft Office\\root\\Office16\\WINWORD.EXE"
			\ "$(wslpath -w %c)" &
filetype	{*.pptx,*.ppt,*.odp},
			\<application/vnd.openxmlformats-officedocument.presentationml*,
			\application/vnd.ms-powerpoint*,application/mspowerpoint>
			\ {Open in PowerPoint}
			\ cmd.exe /c start
			\ "C:\\Program Files\\Microsoft Office\\root\\Office16\\POWERPNT.EXE"
			\ "$(wslpath -w %c)" &

" --- Torrent ---
filetype	{*.torrent},<application/x-bittorrent>
			\ {Open in qBittorrent}
			\ cmd.exe /c start
			\ "O:\\Scoop\\Local\\apps\\qbittorrent\\current\\qbittorrent.exe"
			\ "$(wslpath -w %c)" &
fileviewer	{*.torrent},<application/x-bittorrent>
			\ strings %c

" --- GPG signature ---
filetype {*.asc},<application/pgp-signature>
       \ {Check signature} !!gpg --verify %c

" --- Checksums ---
filetype	*.md5		{Check MD5 hash sum}		md5sum -c %f %S
filetype	*.sha1		{Check SHA1 hash sum}		sha1sum -c %f %S
filetype	*.sha256	{Check SHA256 hash sum}		sha256sum -c %f %S
filetype	*.sha512	{Check SHA512 hash sum}		sha512sum -c %f %S

" --- Object Files ---
filetype	{*.o},<application/x-object> nm %f | less

" --- Archives ---
filetype	*.bz2	bzip2 -d %f
filetype	*.gz	gunzip %f

filetype	{*.zip,*.jar,*.war,*.ear,*.oxt},
			\<application/zip,application/java-archive>
			\ {View contents} unzip -l %c | less,
			\ {Extract here} unzip %f
fileviewer	{*.zip,*.jar,*.war,*.ear,*.oxt},
			\<application/zip,application/java-archive>
			\ unzip -l %c

filetype	{*.tar,*.tar.bz2,*.tbz2,*.tgz,*.tar.gz,*.tar.xz,*.txz,*.tar.zst,*.tzst},
			\<application/x-tar>
			\ tar -xf %f
fileviewer	{*.tar,*.tar.bz2,*.tbz2,*.tgz,*.tar.gz,*.tar.xz,*.txz,*.tar.zst,*.tzst},
			\<application/x-tar>
			\ tar -tf %c

" }}}

